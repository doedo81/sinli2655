{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider !== 'anonymous'"
      }
    },
    "classCodes": {
      "$code": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous'",
        ".write": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && (!data.exists() || root.child('rooms').child(data.val() + '').child('_meta/ownerUid').val() === auth.uid) && (!newData.exists() || newData.parent().parent().child('rooms').child(newData.val() + '').child('_meta/ownerUid').val() === auth.uid)"
      }
    },
    "studentCodes": {
      "$code": {
        ".read": true,
        ".write": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && (!data.exists() || root.child('rooms').child(data.val() + '').child('_members').child(auth.uid).exists() || root.child('rooms').child(data.val() + '').child('_meta/ownerUid').val() === auth.uid) && (!newData.exists() || newData.parent().parent().child('rooms').child(newData.val() + '').child('_members').child(auth.uid).exists())"
      }
    },
    "rooms": {
      "$cid": {
        ".read": "auth != null && (data.child('_meta/ownerUid').val() === auth.uid || data.child('_members').child(auth.uid).exists())",
        ".write": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && (!data.exists() || data.child('_meta/ownerUid').val() === auth.uid || data.child('_members').child(auth.uid).exists())",
        "_members": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider !== 'anonymous' && ( !newData.exists() || !root.child('rooms').child($cid).child('_meta/ownerUid').exists() || root.child('rooms').child($cid).child('_meta/ownerUid').val() === auth.uid || ( root.child('rooms').child($cid).child('_meta/code').exists() && newData.child('code').val() === root.child('rooms').child($cid).child('_meta/code').val() ) )"
          }
        },
        "studentSessions": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && (!newData.exists() || (newData.child('num').isString() && newData.child('h').isString() && root.child('rooms').child($cid).child('secrets/pw').child(newData.child('num').val()).val() === newData.child('h').val()))"
          }
        },
        "settings": {
          "dashboardDefaults": {
            ".read": "auth != null"
          }
        },
        "rpg": {
          ".read": "auth != null && root.child('rooms').child($cid).child('studentSessions').child(auth.uid).exists()",
          "students": {
            "$num": {
              "head":       { ".write": "auth != null && root.child('rooms').child($cid).child('studentSessions').child(auth.uid).child('num').val() === $num" },
              "pet":        { ".write": "auth != null && root.child('rooms').child($cid).child('studentSessions').child(auth.uid).child('num').val() === $num" },
              "frame":      { ".write": "auth != null && root.child('rooms').child($cid).child('studentSessions').child(auth.uid).child('num').val() === $num" },
              "job":        { ".write": "auth != null && root.child('rooms').child($cid).child('studentSessions').child(auth.uid).child('num').val() === $num" },
              "inv":        { ".write": "auth != null && root.child('rooms').child($cid).child('studentSessions').child(auth.uid).child('num').val() === $num" },
              "equip":      { ".write": "auth != null && root.child('rooms').child($cid).child('studentSessions').child(auth.uid).child('num').val() === $num" },
              "spent":      { ".write": "auth != null && root.child('rooms').child($cid).child('studentSessions').child(auth.uid).child('num').val() === $num && newData.isNumber() && newData.val() >= (data.exists() ? data.val() : 0)" },
              "coinBonus":  { ".write": "auth != null && root.child('rooms').child($cid).child('studentSessions').child(auth.uid).child('num').val() === $num && newData.isNumber() && newData.val() >= (data.exists() ? data.val() : 0) && newData.val() <= (data.exists() ? data.val() : 0) + 15" },
              "bw":         { ".write": "auth != null && root.child('rooms').child($cid).child('studentSessions').child(auth.uid).child('num').val() === $num && newData.isNumber() && newData.val() <= (data.exists() ? data.val() : 0) + 1" },
              "bl":         { ".write": "auth != null && root.child('rooms').child($cid).child('studentSessions').child(auth.uid).child('num').val() === $num && newData.isNumber() && newData.val() <= (data.exists() ? data.val() : 0) + 1" },
              "battleDay":  { ".write": "auth != null && root.child('rooms').child($cid).child('studentSessions').child(auth.uid).child('num').val() === $num" },
              "battleWins": { ".write": "auth != null && root.child('rooms').child($cid).child('studentSessions').child(auth.uid).child('num').val() === $num && newData.isNumber() && newData.val() <= 3" }
            }
          }
        },
        "reading": {
          ".read": "auth != null && root.child('rooms').child($cid).child('studentSessions').child(auth.uid).exists()",
          "students": {
            "$num": {
              "books":   { ".write": "auth != null && root.child('rooms').child($cid).child('studentSessions').child(auth.uid).child('num').val() === $num" },
              "entries": { ".write": "auth != null && root.child('rooms').child($cid).child('studentSessions').child(auth.uid).child('num').val() === $num" },
              "streak":  { ".write": "auth != null && root.child('rooms').child($cid).child('studentSessions').child(auth.uid).child('num').val() === $num" }
            }
          }
        },
        "battles": {
          ".read": "auth != null && root.child('rooms').child($cid).child('studentSessions').child(auth.uid).exists()",
          ".write": "auth != null && root.child('rooms').child($cid).child('studentSessions').child(auth.uid).exists()"
        }
      }
    },
    "tujawang": {
      "$code": {
        ".read": true,
        ".write": true
      }
    },
    "nunchi": {
      "$code": {
        ".read": true,
        ".write": true
      }
    }
  }
}
